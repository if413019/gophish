# E-Learning Notification Email Configuration
# This SMTP server is used to send enrollment notifications to victims

# SMTP Server Configuration
ELEARNING_SMTP_HOST=smtp.gmail.com
ELEARNING_SMTP_PORT=587
ELEARNING_SMTP_USERNAME=your-email@gmail.com
ELEARNING_SMTP_PASSWORD=your-app-password
ELEARNING_SMTP_FROM=Security Awareness <security@yourcompany.com>
ELEARNING_SMTP_USE_TLS=true

# Course Access Configuration
ELEARNING_BASE_URL=https://your-gophish-domain.com
ELEARNING_DEFAULT_PASSWORD=TempPass123!

# Email Template Configuration
ELEARNING_EMAIL_SUBJECT=Security Awareness Training Required
ELEARNING_COMPANY_NAME=Your Company Name